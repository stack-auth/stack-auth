{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "hexclave-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["run", "dev"],
      "port": 8101
    },
    {
      "name": "hexclave-dev-basic",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["run", "dev:basic"],
      "port": 8101
    },
    {
      "name": "hexclave-backend-prod",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["-C", "apps/backend", "start"],
      "port": 8102
    },
    {
      "name": "hexclave-backend-prod-devenv",
      "runtimeExecutable": "env",
