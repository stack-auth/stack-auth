      "port": 8102
    },
    {
      "name": "hexclave-dashboard-prod",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["-C", "apps/dashboard", "start"],
      "port": 8101
    },
    {
      "name": "hexclave-bulldozer",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["-C", "apps/bulldozer-js", "start"],
      "port": 8146
    },
    {
      "name": "hexclave-mock-oauth",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["-C", "apps/mock-oauth-server", "start"],
      "port": 8114
    }
  ]
}
