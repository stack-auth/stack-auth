{
  "name": "@hexclave/marshal",
  "version": "1.0.71",
  "repository": "https://github.com/hexclave/hexclave",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "NODE_ENV=development tsx watch --clear-screen=false src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --ext .ts .",
    "clean": "rimraf dist && rimraf node_modules"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1089.0",
    "@aws-sdk/s3-request-presigner": "^3.1089.0",
    "@elysiajs/node": "^1.4.5",
    "dotenv": "^16.6.1",
    "elysia": "^1.4.28"
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "rimraf": "^5.0.5",
    "tsx": "4.15.5",
    "typescript": "5.9.3",
    "vitest": "^2.1.9"
  },
  "packageManager": "pnpm@11.5.0"
}
