# Local development: everything mocked. Fly API calls go to the fly-mock docker service,
# builds use the mock builder (instant fake digest), and the bucket is the s3mock container.
# Port-prefix-dependent URLs (s3mock, fly-mock) are derived in src/config.ts from
# NEXT_PUBLIC_HEXCLAVE_PORT_PREFIX — plain dotenv does not expand ${...} placeholders.
MARSHAL_API_KEY=mock_hexclave_marshal_key
MARSHAL_ENV_ID=dev
MARSHAL_FLY_API_TOKEN=mock_hexclave_fly_key
MARSHAL_FLY_ORG_SLUG=hexclave-dev
MARSHAL_BUILDER=mock
MARSHAL_S3_REGION=us-east-1
MARSHAL_S3_ACCESS_KEY_ID=s3mockroot
MARSHAL_S3_SECRET_ACCESS_KEY=s3mockroot
MARSHAL_S3_BUCKET=marshal
MARSHAL_S3_FORCE_PATH_STYLE=1
