# Hexclave
NEXT_PUBLIC_STACK_API_URL=REPLACE_ME
NEXT_PUBLIC_STACK_PROJECT_ID=REPLACE_ME
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=REPLACE_ME
STACK_SECRET_SERVER_KEY=REPLACE_ME
NEXT_PUBLIC_STACK_DASHBOARD_URL=REPLACE_ME
# SpacetimeDB
NEXT_PUBLIC_SPACETIMEDB_HOST=REPLACE_ME
NEXT_PUBLIC_SPACETIMEDB_DB_NAME=REPLACE_ME
# Eval suite (see src/lib/evals/config.ts). Same values as apps/backend.
# OpenRouter API key (sk-or-...) — used for sandboxed Claude Code steps and the control chat agent.
STACK_OPENROUTER_API_KEY=REPLACE_ME
# Vercel Sandbox credentials — runs execute inside Vercel Sandboxes.
STACK_VERCEL_SANDBOX_TOKEN=REPLACE_ME
STACK_VERCEL_SANDBOX_TEAM_ID=REPLACE_ME
STACK_VERCEL_SANDBOX_PROJECT_ID=REPLACE_ME
# Must match the token injected into the SpacetimeDB module at publish time (defaults to "change-me" in dev).
STACK_MCP_LOG_TOKEN=REPLACE_ME
# Required to use the eval API outside development (sent as x-eval-admin-token header).
STACK_EVAL_ADMIN_TOKEN=REPLACE_ME
