# Client (public) — inlined into the browser bundle.
# These use literal ports rather than ${NEXT_PUBLIC_STACK_PORT_PREFIX:-81}…
# because Vite's dotenv-expand does not reliably honor the POSIX ":-default"
# syntax. If you run with a non-default port prefix, override these in
# .env.local.
VITE_STACK_API_URL=http://localhost:8102
VITE_STACK_PROJECT_ID=internal
VITE_STACK_PUBLISHABLE_CLIENT_KEY=this-publishable-client-key-is-for-local-development-only
VITE_STACK_IS_LOCAL_EMULATOR=false
VITE_STACK_DOCS_BASE_URL=http://localhost:8126
VITE_STACK_DEBUGGER_ON_ASSERTION_ERROR=false

# Server-only secrets — read via process.env inside server functions.
STACK_SECRET_SERVER_KEY=this-secret-server-key-is-for-local-development-only
