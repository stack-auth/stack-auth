  "abstained": {
    "transports[0].spec.apiVersionPinning": "The connector sends no Accept-version or API-version header and no version path segment; the host `api2.frontapp.com` embeds a '2' but nothing in the code treats it as a version knob, so no pinning mechanism is asserted.",
    "transports[0].spec.defaultHeaders": "Only the Authorization header is set, and that comes from the CDK TokenSource rather than a connector-declared default header map.",
    "execution.defaultSchedule": "No connector-level schedule exists; scheduling is declared per binding via initial_config.interval. See unionMisfits.",
    "execution.continuity": "mode is 'poll' with no server-side artifacts — the connector creates nothing on Front's side and holds only its own datetime checkpoints, so the field is null rather than unknown.",
    "streams[*].pull.backfill": "The connector has no separate historical leg. Full-refresh resources re-snapshot the whole collection each interval; incremental resources start from `start_date` and use the same code path forever. Nothing distinguishes a backfill pull shape.",
    "streams[7].cursorField": "Conversations records carry no update timestamp — the code says so explicitly. The checkpoint is the search window's end datetime held in connector state, not a field on the record, so no record-level cursorField can be named.",
    "streams[5].supportedSyncModes.full_refresh": "events/contacts bindings are opened with fetch_changes only (no fetch_snapshot). 'full_refresh' is listed because a from-`start_date` run replays all history through the same incremental path, but the connector does not offer a distinct full-refresh mode for them.",
    "streams[*].pull.*.params.sort_order": "Present for events/contacts only ('asc'); the full-refresh and conversations paths send no sort parameters, so no connector-wide ordering guarantee is asserted.",
    "discovery": "streamMode is 'static' — the eight bindings come from FULL_REFRESH_RESOURCES, INCREMENTAL_RESOURCES_WITH_CURSOR_FIELDS and a hardcoded conversations resource. Nothing is read from the customer's account to build the list."
  }
