  "authTierOverall": "T1_SIMPLE",
  "authTierRationale": "The only credential mode is estuary_cdk.flow.AccessToken ('Private App Credentials'), a single user-supplied secret string. resources.py constructs TokenSource(oauth_spec=None, credentials=config.credentials), so no OAuth app registration and no refresh token are involved; the CDK's TokenSource returns the AccessToken verbatim with the default 'Bearer' token type on the default 'Authorization' header. A Front admin self-serves this token from Front's developer settings.",

  "unionMisfits": [
    {
      "where": "streams[7].pull.incremental (conversations)",
      "description": "The incremental filter is not a query parameter at all — it is encoded into a URL-quoted PATH SEGMENT (a Front search expression 'after:<ts> before:<ts>'), and it is a bounded WINDOW (both ends), not a single since-watermark. `incrementalParam` cannot express either property, so it is null here and the semantics are carried in prose inside `pathPlaceholders`.",
      "proposedShape": {
        "incrementalWindow": {
          "carrier": "path_segment",
          "template": "after:{start} before:{end}",
          "format": "unix_seconds_millis_truncated",
          "boundsInclusive": true,
          "maxWindow": "15 days",
          "lagFromNow": "2 minutes",
          "checkpointsPerWindow": true
        }
      }
    },
    {
      "where": "streams[*].pull.incremental.incrementalParam.param (events, contacts)",
      "description": "The incremental parameter is a bracketed sub-key of a filter object, 'q[after]' / 'q[updated_after]', not a flat parameter name; a consumer that URL-encodes the brackets or treats the name as an opaque identifier will build a wrong request.",
      "proposedShape": { "paramFamily": "q", "paramKey": "after", "encoding": "unencoded_brackets" }
    },
    {
      "where": "streams[0..4] (full-refresh resources)",
      "description": "models.py comments these five resources as 'do not support pagination', yet the shared snapshot fetcher unconditionally sends limit=100 and follows _pagination.next. The declared paginator is what the code does, not what the comment claims; treat the comment as stale rather than as a contradicting fact.",
      "proposedShape": { "paginatorAsserted": "cursor", "sourceCommentClaims": "none" }
    },
    {
      "where": "execution.defaultSchedule",
      "description": "There is no connector-wide schedule; every binding ships its own initial_config interval (5m, or 7m for conversations). The per-stream `schedules` list carries it, and the connector-level field is null — recorded here only so the null is not read as 'unknown'.",
      "proposedShape": { "defaultSchedule": null, "reason": "per_binding_only" }
    }
  ],

