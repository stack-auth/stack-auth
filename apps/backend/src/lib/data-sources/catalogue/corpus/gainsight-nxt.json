  "authTierOverall": "T1_SIMPLE",
  "authTierRationale": "The only credential mode is a single self-serve Gainsight NXT access key pasted into `credentials.access_token`. TokenSource is constructed with oauth_spec=None, so no OAuth app registration and no refresh token are involved; the CDK sends the raw token as the value of a non-default `AccessKey` header with no token-type prefix.",

  "unionMisfits": [
    {
      "where": "streams[].pull.*.paginator",
      "description": "The paginator is offset/limit, but every value travels in the JSON request body of a POST, not in a query string. The v2.1 offset member has no place to say that; `tokenTo: \"body_field\"` was borrowed from the cursor axes to express it. Additionally the offset is advanced by the number of records actually decoded (offset += count), not by the fixed page size.",
      "proposedShape": { "type": "offset", "limitParam": "limit", "offsetParam": "offset", "pageSize": 5000, "tokenTo": "body_field", "offsetAdvance": "records_returned", "terminateOn": "empty_page" }
    },
    {
      "where": "streams[].pull.*.paginator.terminateOn",
      "description": "Termination is on an EMPTY page (zero records decoded), not on a page shorter than the 5000 limit. The code never compares count to the limit, so a partial page causes one extra request. `short_page` is the closest available enum value but is not literally what the code does.",
      "proposedShape": { "terminateOn": "empty_page" }
    },
    {
      "where": "streams[].pull.*.incrementalParam",
      "description": "The incremental bound is not a request parameter but a structured filter object inside the POST body: {where: {conditions: [{name: <modified date field>, alias: 'A', value: [<iso start>, <iso end>], operator: 'BTW'|'GTE'}], expression: 'A'}}, paired with orderBy on the same field. There is no flat `param` name to report.",
      "proposedShape": { "kind": "body_filter", "field": "ModifiedDate|LastModifiedDate", "operator": "BTW", "boundsFormat": "iso8601", "location": "body.where.conditions[0].value" }
    },
    {
      "where": "streams[].pull",
      "description": "Before any binding can pull, the connector issues a per-object metadata request GET /v1/meta/services/objects/{OBJECT_NAME}/describe?ic=false&cl=0&idd=false&ihc=false&piec=false, whose fieldName list becomes the `select` array of every subsequent query. This is a required per-stream prelude request that the PullSpec union cannot express; it is field discovery, not stream discovery, so `discovery` stays null.",
      "proposedShape": { "prelude": { "kind": "http", "path": "/v1/meta/services/objects/{OBJECT_NAME}/describe", "httpMethod": "GET", "recordsPath": "data[0].fields", "feeds": "select" } }
    },
    {
      "where": "streams[].pull.incremental",
      "description": "The incremental leg walks time in fixed 30-day windows capped at now (end_date = min(cursor + 30 days, now)) and then advances the log cursor to max(observed modified date) + 1 second. Both the window-chunking and the +1s cursor bump are semantics the PullSpec has no field for, and the +1s bump can skip records modified within the same second.",
      "proposedShape": { "windowing": { "kind": "fixed_span", "span": "30d", "cappedAtNow": true }, "cursorAdvance": "max(record cursor) + 1s" }
    }
  ],

