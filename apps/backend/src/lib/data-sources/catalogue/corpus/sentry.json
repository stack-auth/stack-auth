    { "name": "credentials.access_token", "displayName": "Access Token", "required": true, "secret": true, "scope": "endpoint", "type": "string", "description": "Sentry auth token sent as a bearer token." },
    { "name": "start_date", "displayName": "Start Date", "required": false, "secret": false, "scope": "endpoint", "type": "date", "description": "UTC datetime; data generated before it is not replicated. Defaults to 30 days before now." },
    { "name": "advanced.window_size", "displayName": "Window size", "required": false, "secret": false, "scope": "endpoint", "type": "string", "description": "ISO 8601 duration for the Issues backfill date window; default P7D, min 30s, max 365d." },
    { "name": "explore_queries", "displayName": "Explore Queries", "required": false, "secret": false, "scope": "endpoint", "type": "array", "description": "User-defined Explore query streams; each entry becomes its own incremental stream." },
    { "name": "explore_queries[].name", "displayName": "Name", "required": true, "secret": false, "scope": "endpoint", "type": "string", "description": "Stream name; prefixed with 'custom_explore_' if not already." },
    { "name": "explore_queries[].dataset", "displayName": "Dataset", "required": true, "secret": false, "scope": "endpoint", "type": "string", "description": "One of 'spans', 'errors', 'transactions'." },
