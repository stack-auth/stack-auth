    { "name": "explore_queries[].query", "displayName": "Query", "required": false, "secret": false, "scope": "endpoint", "type": "string", "description": "Optional Sentry search query; a 'timestamp:' clause is rejected because the connector owns the time window." },
    { "name": "explore_queries[].projects", "displayName": "Projects", "required": false, "secret": false, "scope": "endpoint", "type": "string", "description": "Comma-separated numeric project IDs; empty means all projects (-1)." }
  ],

