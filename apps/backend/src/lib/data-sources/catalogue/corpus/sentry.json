  "authTierOverall": "T1_SIMPLE",
  "authTierRationale": "The only credential mode is the CDK's `AccessToken` model (a single secret `access_token` field, discriminator 'Private App Credentials'). The connector explicitly constructs `TokenSource(oauth_spec=None, ...)`, so no OAuth app registration or refresh token is involved; the CDK sends the value verbatim as `Authorization: Bearer <token>`. A user creates one Sentry auth token in their org settings — one self-serve secret, hence T1.",

  "unionMisfits": [
    {
      "where": "streams[*].pull.*.paginator",
      "description": "The mechanism is `next_url` (the URL is followed verbatim and all previously-sent params are cleared), but the URL comes from the RFC 5988 `Link` *response header* with rel=\"next\", and termination is decided by that link's `results` attribute being the string \"true\" rather than by the token's absence. The schema's `next_url` member only carries `nextUrlPath` and has no place for `tokenFrom`/`terminateOn`, while the `cursor` member cannot express 'follow verbatim'. Emitted as `next_url` with extra axis keys.",
      "proposedShape": {
        "type": "next_url",
        "tokenFrom": "header",
        "headerName": "Link",
        "linkRel": "next",
        "terminateOn": "link_attribute",
        "terminationAttribute": { "name": "results", "continueWhen": "true" }
      }
    },
    {
      "where": "streams[custom_explore_*].pull.*.paginator",
      "description": "The Explore streams layer a second, outer pagination loop on top of the Link-header paginator: Sentry caps offset pagination at 10,000 rows per query, so on saturation the connector abandons the link chain and re-issues a fresh time-bounded query starting at the highest row timestamp seen. That is a record_cursor-style outer walk composed with a next_url inner walk; the schema allows only one paginator per PullSpec.",
      "proposedShape": {
        "paginator": { "type": "next_url", "tokenFrom": "header" },
        "outerWalk": { "type": "record_cursor", "recordField": "timestamp", "resetAfterRows": 10000, "boundedBy": "start/end or timestamp: clauses in `query`" }
      }
    },
    {
      "where": "streams[custom_explore_*]",
      "description": "This stream is neither `static` nor `discovered` in the schema's sense: it exists only because the user typed an entry into the `explore_queries` endpoint-config array, and its name, primary key (spans key on /trace+/id, errors/transactions on /id), row model, and field list all derive from that entry. It is config-defined, and its PK varies by the chosen dataset — a single `primaryKey` cannot represent it.",
      "proposedShape": { "origin": "config_defined", "primaryKeyByVariant": { "spans": ["/trace", "/id"], "errors": ["/id"], "transactions": ["/id"] } }
    },
    {
      "where": "streams[*].pull.incremental.incrementalParam (custom_explore_*)",
      "description": "The incremental leg does not pass its lower/upper bounds as dedicated params. It embeds them as Sentry search-syntax clauses (`timestamp:>=<iso> timestamp:<<iso>`) inside the single `query` string, alongside a coarse `statsPeriod=30d`. `incrementalParam` assumes one param carrying one formatted timestamp.",
      "proposedShape": { "kind": "embedded_in_query_dsl", "param": "query", "lowerClause": "timestamp:>=", "upperClause": "timestamp:<", "format": "iso8601", "coarseWindowParam": "statsPeriod" }
    }
  ],

