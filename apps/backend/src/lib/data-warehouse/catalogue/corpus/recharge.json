  "authTierOverall": "T1_SIMPLE",
  "authTierRationale": "The only credential is a single self-serve Recharge Access Token pasted into `access_token`, sent verbatim in the `X-Recharge-Access-Token` request header by RechargeTokenAuthenticator. No OAuth is wired at all: `__main__.py` constructs the estuary-cdk CaptureShim with `oauth2=None`, and the spec exposes no client id/secret or refresh token fields. One key, no app registration, no refresh flow.",

  "unionMisfits": [
    {
      "where": "streams[].pull.*",
      "description": "Every stream except shop and metafields is swept in fixed-length date windows over the `updated_at` axis (period_in_days = 30, 14 for subscriptions), issuing one paginated request series per window with `updated_at_min`/`updated_at_max` bounds. The PullSpec has `incrementalParam` for the lower bound but no place for the window length or the paired upper bound, so the windowing strategy is invisible in the emitted shape.",
      "proposedShape": { "windowing": { "kind": "closed_interval", "lowerParam": "updated_at_min", "upperParam": "updated_at_max", "windowLength": "P30D", "orderParam": "sort_by", "orderValue": "updated_at-asc" } }
    },
    {
      "where": "streams[7] (orders)",
      "description": "The `orders` stream has TWO mutually exclusive pull shapes selected by the endpoint-level boolean `use_orders_deprecated_api`: when true (the spec default) it uses api-version header 2021-01 with a page-number paginator; when false it uses 2021-11 with the `next_cursor` cursor paginator. The schema allows backfill/incremental/snapshot variants but not config-switched alternatives of the same leg. The emitted `orders` pull reflects the spec default (deprecated = true, page paginator); the checked-in config.yaml sets it to false.",
      "proposedShape": { "pullVariants": [ { "when": "use_orders_deprecated_api == true", "apiVersion": "2021-01", "paginator": { "type": "page" } }, { "when": "use_orders_deprecated_api == false", "apiVersion": "2021-11", "paginator": { "type": "cursor", "cursorPath": "next_cursor" } } ] }
    },
    {
      "where": "transports[0].spec.apiVersionPinning",
      "description": "The API version is not a connector-wide constant: it is a per-stream request header (`x-recharge-version`), mixing 2021-11 and 2021-01 within a single capture. `apiVersionPinning` is a single string on the transport and cannot express a per-stream value.",
      "proposedShape": { "apiVersionPinning": { "kind": "header", "header": "x-recharge-version", "perStream": true, "values": { "default": "2021-11", "products": "2021-01", "shop": "2021-01", "orders": "2021-01 | 2021-11 (config-switched)" } } }
    },
    {
      "where": "streams[].pull.*.incrementalParam.format",
      "description": "`updated_at_min`/`updated_at_max` are rendered as `%Y-%m-%d %H:%M:%S` (space separator, no timezone designator), which is not strict ISO-8601 even though the `start_date` config field is validated as `YYYY-MM-DDTHH:MM:SSZ`. The format enum has no member for this.",
      "proposedShape": { "format": "sql_datetime", "pattern": "%Y-%m-%d %H:%M:%S" }
    },
    {
      "where": "streams[9] (shop).pull.snapshot",
      "description": "The `shop` stream sets `data_path = None`, so the entire response body is emitted as one record rather than an array being unwrapped from an envelope key; `recordsPath: null` is used to mean \"the whole document is the record\", which is ambiguous with \"records are at the top level as a bare array\".",
      "proposedShape": { "recordsPath": null, "recordShape": "whole_response_body" }
    },
    {
      "where": "streams[9] (shop).pull.snapshot.paginator",
      "description": "`shop` inherits the deprecated-API page paginator but overrides request_params to return `{}`, so `limit`/`page` are never actually sent on the first request. The inherited next_page_token still compares the record count to limit=250; since the response yields exactly one record it terminates after one page. The paginator is structurally present but functionally inert.",
      "proposedShape": { "type": "none", "inheritedButSuppressed": "page" }
    }
  ],

