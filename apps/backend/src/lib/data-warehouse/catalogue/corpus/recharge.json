{
  "id": "recharge",
  "estuaryDir": "source-recharge",
  "displayName": "Recharge",
  "description": "Imports subscription-commerce data (customers, addresses, subscriptions, charges, orders, onetimes, discounts, products, collections, metafields, shop) from the Recharge Payments API.",
  "category": "payments",

  "transports": [
    {
      "role": "primary",
      "purpose": null,
      "spec": {
        "kind": "http",
        "baseUrl": { "kind": "constant", "value": "https://api.rechargeapps.com/" },
        "defaultHeaders": null,
        "apiVersionPinning": "Request header `x-recharge-version`, set per stream: \"2021-11\" for streams deriving from RechargeStreamModernAPI (addresses, charges, collections, customers, discounts, metafields, onetimes, subscriptions, and orders when use_orders_deprecated_api is false) and \"2021-01\" for streams deriving from RechargeStreamDeprecatedAPI (products, shop, and orders when use_orders_deprecated_api is true)."
      }
    }
  ],

  "credentialModes": [
    {
      "name": "Recharge API access token",
      "appliesToTransport": "primary",
      "tier": "T1_SIMPLE",
      "scheme": { "type": "header", "header": "X-Recharge-Access-Token", "field": "access_token", "prefix": null }
    }
  ],

  "execution": {
    "mode": "poll",
    "defaultSchedule": null,
    "continuity": null
  },

  "configFields": [
    { "name": "access_token", "displayName": "Access Token", "required": true, "secret": true, "scope": "endpoint", "type": "string", "description": "The value of the Recharge Access Token generated." },
    { "name": "start_date", "displayName": "Start Date", "required": true, "secret": false, "scope": "endpoint", "type": "date", "description": "Replicate data from this date onward; format YYYY-MM-DDT00:00:00Z. Data before this date is not replicated." },
    { "name": "use_orders_deprecated_api", "displayName": "Use `Orders` Deprecated API", "required": false, "secret": false, "scope": "endpoint", "type": "boolean", "description": "Whether the Orders stream uses the deprecated 2021-01 API version instead of 2021-11. Defaults to true in the spec." },
    { "name": "stream", "displayName": "Stream", "required": true, "secret": false, "scope": "resource", "type": "string", "description": "Name of the captured stream (from the estuary-cdk airbyte shim ResourceConfig)." },
    { "name": "syncMode", "displayName": "Sync Mode", "required": true, "secret": false, "scope": "resource", "type": "string", "description": "full_refresh or incremental (from the estuary-cdk airbyte shim ResourceConfig)." },
    { "name": "cursorField", "displayName": "Cursor Field", "required": false, "secret": false, "scope": "resource", "type": "array", "description": "Cursor field(s) for incremental bindings; discovery emits [\"updated_at\"] for incremental streams." },
    { "name": "namespace", "displayName": "Namespace", "required": false, "secret": false, "scope": "resource", "type": "string", "description": "Enclosing schema namespace of the resource; unused by this connector (no stream sets a namespace)." }
  ],

