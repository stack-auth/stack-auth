{
  "id": "pendo",
  "estuaryDir": "source-pendo",
  "displayName": "Pendo",
  "description": "Imports Pendo product-analytics data — pages, features, guides, reports, segments, accounts, visitors, track types, their metadata schemas, and guide/poll/page/feature/track event streams.",
  "category": "product",

  "transports": [
    {
      "role": "primary",
      "purpose": null,
      "spec": {
        "kind": "http",
        "baseUrl": {
          "kind": "template",
          "template": "https://{host}/api/v1",
          "placeholders": {
            "host": "endpoint config field `host`, chosen from a fixed regional enum: app.pendo.io (default), us1.app.pendo.io, app.eu.pendo.io, app.jpn.pendo.io, app.au.pendo.io"
          }
        },
        "defaultHeaders": null,
        "apiVersionPinning": "path segment `/api/v1` baked into the base URL"
      }
    }
  ],

  "credentialModes": [
    {
      "name": "Pendo integration key (Private App Credentials)",
      "appliesToTransport": "primary",
      "tier": "T1_SIMPLE",
      "scheme": {
        "type": "header",
        "header": "x-pendo-integration-key",
        "field": "credentials.access_token",
        "prefix": null
      }
    }
  ],

  "execution": {
    "mode": "poll",
    "defaultSchedule": null,
    "continuity": null
  },

  "configFields": [
    { "name": "host", "displayName": "Pendo Host", "required": false, "secret": false, "scope": "endpoint", "type": "string", "description": "Regional Pendo host to connect to; enum of app.pendo.io / us1.app.pendo.io / app.eu.pendo.io / app.jpn.pendo.io / app.au.pendo.io, defaulting to app.pendo.io." },
    { "name": "startDate", "displayName": "Start Date", "required": false, "secret": false, "scope": "endpoint", "type": "date", "description": "UTC YYYY-MM-DDTHH:MM:SSZ; data generated before this is not replicated. Defaults to one hour before the present." },
    { "name": "credentials.credentials_title", "displayName": "Credentials Title", "required": false, "secret": false, "scope": "endpoint", "type": "string", "description": "Constant discriminator, always \"Private App Credentials\"." },
    { "name": "credentials.access_token", "displayName": "Access Token", "required": true, "secret": true, "scope": "endpoint", "type": "string", "description": "Pendo integration key, sent verbatim in the x-pendo-integration-key header." },
    { "name": "advanced.incremental_limit", "displayName": "Incremental Limit", "required": false, "secret": false, "scope": "endpoint", "type": "number", "description": "Max documents per API call during incremental replication; default 1000, range 1..50000." },
    { "name": "advanced.backfill_limit", "displayName": "Backfill Limit", "required": false, "secret": false, "scope": "endpoint", "type": "number", "description": "Max documents per API call during historical backfills; default 50000, range 1..50000." },
    { "name": "name", "displayName": "Name", "required": true, "secret": false, "scope": "resource", "type": "string", "description": "Name of this resource (CDK-standard ResourceConfig field)." },
    { "name": "interval", "displayName": "Interval", "required": false, "secret": false, "scope": "resource", "type": "string", "description": "Interval between updates for this resource; the connector proposes PT5M for every binding." }
  ],

