{
  "id": "impact-native",
  "estuaryDir": "source-impact-native",
  "displayName": "Impact.com",
  "description": "Imports partnership/affiliate marketing data (campaigns, actions, invoices, contracts, promo codes, ads, reports) from an Impact.com brand account.",
  "category": "marketing",

  "transports": [
    {
      "role": "primary",
      "purpose": null,
      "spec": {
        "kind": "http",
        "baseUrl": {
          "kind": "template",
          "template": "https://api.impact.com/{api_catalog_segment}/{account_sid}",
          "placeholders": {
            "api_catalog_segment": "Hardcoded to the literal 'Advertisers' by the module constant API_CATALOG. The user-facing `api_catalog` enum (Brand/Agency/Partners) does NOT change this segment; it only gates whether the stream list is built at all, and only 'Brand' is implemented.",
            "account_sid": "The Impact Account SID, taken from `credentials.username` — the same value used as the HTTP Basic username. Passed into every fetch function as `account_sid`."
          }
        },
        "defaultHeaders": { "Accept": "application/json" },
        "apiVersionPinning": null
      }
    }
  ],

  "credentialModes": [
    {
      "name": "Account SID & Auth Token (HTTP Basic)",
      "appliesToTransport": "primary",
      "tier": "T1_SIMPLE",
      "scheme": {
        "type": "basic",
        "usernameField": "credentials.username",
        "passwordField": "credentials.password"
      }
    }
  ],

  "execution": {
    "mode": "poll",
    "defaultSchedule": null,
    "continuity": {
      "artifacts": [],
      "customerSideAccrual": null,
      "ourSideLoss": "Actions/ActionInquiries incremental only re-reads the plain Actions endpoint, which the connector's own comment says returns roughly the last 7 days; if polling pauses longer than that window, Actions changes in the gap are never re-observed by the incremental leg. Other streams re-query by timestamp and are not time-limited, except that Actions backfill windows are capped at 3 years (1095 days) in the past.",
      "resumeWindow": "~7 days for Actions/ActionInquiries incremental; unbounded for the timestamp-filtered streams",
      "releasedOnShutdown": null,
      "notes": "Pure stateless HTTP polling — nothing is created or held on Impact.com's side, so nothing accrues on the customer. The only continuity risk is our own: the Actions incremental endpoint's short lookback. A 1-hour INCREMENTAL_LAG horizon is also subtracted from 'now' before advancing any incremental cursor, to tolerate Impact's eventual consistency."
    }
  },

  "configFields": [
    { "name": "credentials.username", "displayName": "Username", "required": true, "secret": false, "scope": "endpoint", "type": "string", "description": "Impact Account SID; also interpolated into every request path." },
    { "name": "credentials.password", "displayName": "Password", "required": true, "secret": true, "scope": "endpoint", "type": "string", "description": "Impact auth token." },
    { "name": "credentials.credentials_title", "displayName": "Credentials Title", "required": false, "secret": false, "scope": "endpoint", "type": "string", "description": "Discriminator constant, always 'Username & Password'." },
    { "name": "api_catalog", "displayName": "API Catalog (Brand, Agency, Partner)", "required": true, "secret": false, "scope": "endpoint", "type": "string", "description": "Enum Brand|Agency|Partners. Only 'Brand' is implemented; the other two branches produce no streams." },
    { "name": "start_date", "displayName": "Start Date", "required": false, "secret": false, "scope": "endpoint", "type": "date", "description": "UTC ISO8601. Defaults to 30 days before now. Bounds the backfill leg." },
    { "name": "name", "displayName": "Name", "required": true, "secret": false, "scope": "resource", "type": "string", "description": "CDK ResourceConfig: name of the bound resource." },
    { "name": "interval", "displayName": "Interval", "required": false, "secret": false, "scope": "resource", "type": "string", "description": "CDK ResourceConfig: ISO8601 duration between updates. Connector recommends PT5M for every stream." }
  ],

  "streamMode": "static",
  "discovery": null,

  "streams": [
    {
      "name": "Actions",
      "origin": "static",
      "kind": "actual",
      "primaryKey": ["/Id"],
      "primaryKeyKind": "json_pointers",
      "cursorField": "CreationDate",
      "supportedSyncModes": ["full_refresh", "incremental"],
      "writeDisposition": "merge",
      "schedules": [{ "role": "poll", "schedule": { "kind": "interval", "seconds": 300 } }],
      "pull": {
        "backfill": {
          "kind": "http",
          "path": "/Advertisers/{account_sid}/Actions",
          "httpMethod": "GET",
          "recordsPath": "Actions",
          "params": { "PageSize": 20000, "CampaignId": "<each Campaigns.Id>", "ActionDateStart": "<window start>", "ActionDateEnd": "<window end>" },
          "pathPlaceholders": { "account_sid": "credentials.username" },
          "paginator": { "type": "next_url", "nextUrlPath": "@nextpageuri", "tokenFrom": "body", "tokenTo": "full_url", "terminateOn": "absent_token" },
          "incrementalParam": { "param": "ActionDateStart", "format": "iso8601" }
        },
        "incremental": {
          "kind": "http",
          "path": "/Advertisers/{account_sid}/Actions",
          "httpMethod": "GET",
          "recordsPath": "Actions",
          "params": { "PageSize": 20000, "CampaignId": "<each Campaigns.Id>" },
          "pathPlaceholders": { "account_sid": "credentials.username" },
          "paginator": { "type": "next_url", "nextUrlPath": "@nextpageuri", "tokenFrom": "body", "tokenTo": "full_url", "terminateOn": "absent_token" },
          "incrementalParam": null
        },
