{
  "id": "shopify",
  "estuaryDir": "source-shopify",
  "displayName": "Shopify (legacy REST)",
  "description": "Imports Shopify store commerce data (orders, products, customers, collections, inventory, price rules, transactions, refunds) from the Shopify Admin REST API.",
  "category": "other",

  "transports": [
    {
      "role": "primary",
      "purpose": null,
      "spec": {
        "kind": "http",
        "baseUrl": {
          "kind": "template",
          "template": "https://{store}.myshopify.com/admin/api/{api_version}",
          "placeholders": {
            "store": "endpoint config field `store` (the myshopify subdomain); the whole prefix is overridden verbatim by the optional `admin_url` config field, to which `/api/{api_version}` is still appended",
            "api_version": "hardcoded module constant API_VERSION in tap_shopify/client.py, value 2023-10"
          }
        },
        "defaultHeaders": null,
        "apiVersionPinning": "path segment: /admin/api/2023-10, hardcoded as API_VERSION in client.py (not user-configurable)"
      }
    }
  ],

  "credentialModes": [
    {
      "name": "Access Token",
      "appliesToTransport": "primary",
      "tier": "T1_SIMPLE",
      "scheme": {
        "type": "header",
        "header": "X-Shopify-Access-Token",
        "field": "credentials.access_token",
        "prefix": null
      }
    },
    {
      "name": "Shopify OAuth",
      "appliesToTransport": "primary",
      "tier": "T2_BYO_APP",
      "scheme": {
        "type": "oauth2",
        "authUrl": "https://{config.store}.myshopify.com/admin/oauth/authorize",
        "tokenUrl": "https://{config.store}.myshopify.com/admin/oauth/access_token",
        "scopes": [
          "read_locales",
          "read_products",
          "read_orders",
          "read_checkouts",
          "read_locations",
          "read_inventory",
          "read_fulfillments",
          "read_customers"
        ],
        "grant": "authorization_code"
      }
    }
  ],

  "execution": {
    "mode": "poll",
    "defaultSchedule": null,
    "continuity": {
      "artifacts": [],
      "customerSideAccrual": null,
      "ourSideLoss": null,
      "resumeWindow": null,
      "releasedOnShutdown": null,
      "notes": "Stateless REST polling. Resumption is entirely client-side: the Singer replication_key_value (updated_at, or id for collects) is checkpointed and replayed as updated_at_min/since_id on the next run. No server-side object is created on the Shopify side, so nothing accrues on the customer's infra and nothing expires if we pause. The only pause risk is that the connector re-walks from the last cursor value, and that per-run Link-header page_info cursors are short-lived, but page_info is never persisted across runs."
    }
  },

  "configFields": [
    { "name": "credentials.auth_type", "displayName": "Auth Type", "required": true, "secret": false, "scope": "endpoint", "type": "string", "description": "Discriminator: \"oauth\" or \"access_token\"." },
    { "name": "credentials.client_id", "displayName": "Client ID", "required": true, "secret": true, "scope": "endpoint", "type": "string", "description": "OAuth mode only: Shopify app client id." },
    { "name": "credentials.client_secret", "displayName": "Client Secret", "required": true, "secret": true, "scope": "endpoint", "type": "string", "description": "OAuth mode only: Shopify app client secret." },
    { "name": "credentials.access_token", "displayName": "Access Token", "required": true, "secret": true, "scope": "endpoint", "type": "string", "description": "The access token to authenticate with the Shopify API. Required in BOTH credential modes." },
    { "name": "store", "displayName": "Store", "required": true, "secret": false, "scope": "endpoint", "type": "string", "description": "Shopify store id, the prefix of the admin url e.g. https://[your store].myshopify.com/admin." },
    { "name": "start_date", "displayName": "Start Date", "required": true, "secret": false, "scope": "endpoint", "type": "date", "description": "The earliest record date to sync. Default 2020-01-01." },
    { "name": "admin_url", "displayName": "Admin URL", "required": false, "secret": false, "scope": "endpoint", "type": "string", "description": "The Admin url for the Shopify store; overrides the 'store' property." },
    { "name": "is_plus_account", "displayName": "Is Plus Account", "required": false, "secret": false, "scope": "endpoint", "type": "boolean", "description": "Enables Shopify Plus account endpoints (adds the users stream)." },
    { "name": "stream", "displayName": "Stream", "required": true, "secret": false, "scope": "resource", "type": "string", "description": "Singer stream name for this binding." },
    { "name": "replication_method", "displayName": "Replication Method", "required": true, "secret": false, "scope": "resource", "type": "string", "description": "INCREMENTAL or FULL_TABLE." },
    { "name": "replication_key", "displayName": "Replication Key", "required": false, "secret": false, "scope": "resource", "type": "string", "description": "Field used as the incremental cursor." }
  ],

