  "authTierOverall": "T1_SIMPLE",
  "authTierRationale": "Exactly one credential mode exists: an EndpointConfig.credentials discriminated union whose only member is ApiKey (an estuary_cdk AccessToken subclass) with a single secret field `access_token` titled \"API Key\". TokenSource is constructed with oauth_spec=None, so no OAuth flow, client registration, or refresh token is involved — the user pastes one self-serve Klaviyo private API key and the CDK sends `Authorization: Klaviyo-API-Key <key>`.",

  "unionMisfits": [
    {
      "where": "streams[].pull.*.paginator",
      "description": "The paginator is neither plain next_url following nor a plain envelope-token cursor. `links.next` in the response body is a full absolute URL; the connector urlparse/parse_qs's it, extracts ONLY the `page[cursor]` query parameter, and re-sends that value as `page[cursor]` on the SAME original url with the original params dict retained (mutated in place). Encoding it as {type: cursor, tokenFrom: url_query} loses the intermediate 'read a URL from the body, then pull one query param out of it' step; encoding it as next_url would be wrong, because the URL is NOT followed verbatim.",
      "proposedShape": {
        "type": "cursor",
        "tokenFrom": "url_query_of_body_field",
        "tokenFromPath": "links.next",
        "extractQueryParam": "page[cursor]",
