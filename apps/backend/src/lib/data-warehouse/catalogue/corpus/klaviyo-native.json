{
  "id": "klaviyo-native",
  "estuaryDir": "source-klaviyo-native",
  "displayName": "Klaviyo",
  "description": "Imports Klaviyo marketing data — campaigns, flows, profiles, lists, segments, templates, forms, images, metrics, tags, coupons, push tokens and events — from the Klaviyo REST API.",
  "category": "marketing",

  "transports": [
    {
      "role": "primary",
      "purpose": null,
      "spec": {
        "kind": "http",
        "baseUrl": { "kind": "constant", "value": "https://a.klaviyo.com/api" },
        "defaultHeaders": { "REVISION": "2025-07-15" },
        "apiVersionPinning": "Request header `REVISION`, pinned to the dated value \"2025-07-15\" (API_VERSION), sent on every request in REQUIRED_HEADERS."
      }
    }
  ],

  "credentialModes": [
    {
      "name": "API key (private app key)",
      "appliesToTransport": "primary",
      "tier": "T1_SIMPLE",
      "scheme": {
        "type": "header",
        "header": "Authorization",
        "field": "credentials.access_token",
        "prefix": "Klaviyo-API-Key "
      }
    }
  ],

  "execution": {
    "mode": "poll",
    "defaultSchedule": null,
    "continuity": {
      "artifacts": [],
      "customerSideAccrual": null,
      "ourSideLoss": "Only for the `events` binding: the Klaviyo Events API is eventually consistent, which the connector compensates for with a second `lookback` subtask running EVENTS_EVENTUAL_CONSISTENCY_HORIZON = 4 days behind the realtime subtask. Nothing else is time-limited — all other bindings re-bound by an absolute datetime filter, so an arbitrarily long pause is recoverable.",
      "resumeWindow": null,
      "releasedOnShutdown": null,
      "notes": "Pure stateless HTTP polling. No server-side object is created on the customer's Klaviyo account; state is entirely connector-side (a datetime LogCursor per binding/subtask, and a datetime-string PageCursor for backfills). Stopping between ticks accrues nothing on the customer side."
    }
  },

  "configFields": [
    { "name": "start_date", "displayName": "Start Date", "required": false, "secret": false, "scope": "endpoint", "type": "date", "description": "UTC date and time in the format YYYY-MM-DDTHH:MM:SSZ. Data generated before this date is not replicated. Defaults to 30 days before the present." },
    { "name": "credentials.credentials_title", "displayName": "Authentication", "required": true, "secret": false, "scope": "endpoint", "type": "string", "description": "Discriminator; the only value is \"API Key\"." },
    { "name": "credentials.access_token", "displayName": "API Key", "required": true, "secret": true, "scope": "endpoint", "type": "string", "description": "Klaviyo private API key, sent as `Authorization: Klaviyo-API-Key <key>`." },
    { "name": "advanced.window_size", "displayName": "Window size", "required": false, "secret": false, "scope": "endpoint", "type": "string", "description": "ISO 8601 date-window size for the events backfill (default PT1H, min PT30S, max P365D). Only affects the `events` binding." },
    { "name": "name", "displayName": "Name", "required": true, "secret": false, "scope": "resource", "type": "string", "description": "CDK ResourceConfig binding name." },
    { "name": "interval", "displayName": "Interval", "required": false, "secret": false, "scope": "resource", "type": "string", "description": "CDK ResourceConfig poll interval; the connector ships PT5M for incremental bindings and PT1H for full-refresh bindings." }
  ],

  "streamMode": "static",
  "discovery": null,

