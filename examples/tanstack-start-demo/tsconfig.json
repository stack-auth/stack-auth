{
  "compilerOptions": {
    "jsx": "react-jsx",
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@stackframe/tanstack-start": ["../../packages/tanstack-start/src/index.ts"],
      "@stackframe/tanstack-start/*": ["../../packages/tanstack-start/src/*"],
      "~/*": ["./src/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
