# Publish/consume @hexclave packages from the self-hosted registry. Only the
# @hexclave scope is redirected — everything else still resolves from npmjs, and
# in this monorepo @hexclave/* resolve to local workspace packages. The auth token
# is read from the NODE_AUTH_TOKEN env var (set in CI), never committed.
@hexclave:registry=https://npm.egelhaus.de/
//npm.egelhaus.de/:_authToken=${NODE_AUTH_TOKEN}
